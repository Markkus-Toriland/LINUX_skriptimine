#!/bin/bash
# Skript küsib kasutaja vanust ja ütleb, kes ta vanuse järgi on

echo -n "Sisesta (oma) vanus: "
read vanus

if test $vanus -ge 0 -a $vanus -lt 11
then
    echo "Oled laps"
elif test $vanus -ge 11 -a $vanus -lt 18
then
    echo "Oled nooruk"
elif test $vanus -ge 18 -a $vanus -lt 63
then
    echo "Oled täiskasvanu"
elif test $vanus -ge 63
then
    echo "Oled senjoor"
else
    echo "Vigane sisend! Vanus peab olema positiivne täisarv."
fi
