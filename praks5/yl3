#!/bin/bash
# Skript küsib kellaaega (tundide arvu) ja tervitab vastavalt kellaajale

echo -n "Sisesta aja väärtus: "
read aeg

if [ $aeg -ge 6 ] && [ $aeg -lt 12 ]
then
    echo "Tere hommikust"
elif [ $aeg -ge 12 ] && [ $aeg -lt 18 ]
then
    echo "Tere päevast"
elif [ $aeg -ge 18 ] && [ $aeg -lt 22 ]
then
    echo "Tere õhtust"
elif [ $aeg -ge 22 -a $aeg -le 24 ] || [ $aeg -ge 0 -a $aeg -lt 6 ]
then
    echo "Head ööd!"
else
    echo "Vigane aja väärtus! Sisesta tundide arv vahemikus 0-24."
fi
