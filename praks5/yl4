#!/bin/bash
# Skript loeb kellaaja süsteemist ja tervitab kasutajat nimepidi vastavalt kellaajale

aeg=$(date +%H)
kasutaja=$(whoami)
esitaht=$(echo "${kasutaja:0:1}" | tr '[:lower:]' '[:upper:]')
nimi="$esitaht${kasutaja:1}"

if [ $aeg -ge 6 ] && [ $aeg -lt 12 ]
then
    echo "Tere hommikust, $nimi!"
elif [ $aeg -ge 12 ] && [ $aeg -lt 18 ]
then
    echo "Tere päevast, $nimi!"
elif [ $aeg -ge 18 ] && [ $aeg -lt 22 ]
then
    echo "Tere õhtust, $nimi!"
else
    echo "Head ööd, $nimi!"
fi
